@model IEnumerable<Telemed.Models.Doctor>

@{
    ViewData["Title"] = "Pending Approvals";
}

<style>
    .page-title {
        font-weight: 600;
        color: #343a40;
    }

    .doctor-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-radius: 15px;
    }

        .doctor-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

    /* 🟢 New doctor registration */
    .card-new-doctor {
        border-left: 6px solid #28a745;
        background-color: #f0fff4;
    }

    /* 🔴 Consultation fee change */
    .card-fee-request {
        border-left: 6px solid #dc3545;
        background-color: #fff5f5;
    }

    .legend-box {
        display: flex;
        gap: 20px;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.95rem;
    }

    .legend-color {
        width: 18px;
        height: 18px;
        border-radius: 4px;
    }

    .legend-green {
        background-color: #28a745;
    }

    .legend-red {
        background-color: #dc3545;
    }

    .action-buttons form {
        display: inline-block;
        margin-right: 6px;
    }

    .no-doctors {
        font-style: italic;
        color: #6c757d;
    }
</style>

<div class="container my-5">
    <h2 class="page-title mb-3">Pending Approvals</h2>

    <!-- 🔍 Legend -->
    <div class="legend-box">
        <div class="legend-item">
            <span class="legend-color legend-green"></span>
            <span>New Doctor Registration</span>
        </div>
        <div class="legend-item">
            <span class="legend-color legend-red"></span>
            <span>Consultation Fee Change</span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <p class="no-doctors">No pending requests at the moment.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var doctor in Model)
            {
                bool isFeeRequest = doctor.PendingConsultationFee != null;
                bool isNewDoctor = doctor.PendingConsultationFee == null;

                string cardClass = isFeeRequest
                ? "card-fee-request"
                : "card-new-doctor";

                <div class="col-md-6 col-lg-4">
                    <div class="card doctor-card shadow-sm p-3 @cardClass">
                        <div class="card-body">

                            @if (isNewDoctor)
                            {
                                <span class="badge bg-success mb-2">
                                    New Doctor Registration
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger mb-2">
                                    Consultation Fee Change
                                </span>
                            }

                            <h5 class="mt-2"><strong>@doctor.FullName</strong></h5>

                            <p class="mb-1"><strong>Specialization:</strong> @doctor.Specialization</p>
                            <p class="mb-1"><strong>Qualification:</strong> @doctor.Qualification</p>
                            <p class="mb-1"><strong>BM&DC Number:</strong> @doctor.BMDCNumber</p>
                            <p class="mb-2"><strong>Email:</strong> @doctor.User?.Email</p>

                            @if (isFeeRequest)
                            {
                                <p class="text-muted mb-1">
                                    <strong>Current Fee:</strong> @doctor.ConsultationFee
                                </p>
                                <p class="text-danger mb-3">
                                    <strong>Requested Fee:</strong> @doctor.PendingConsultationFee
                                </p>
                            }
                            else
                            {
                                <p class="mb-3">
                                    <strong>Consultation Fee:</strong> @doctor.ConsultationFee
                                </p>
                            }

                            <div class="action-buttons">
                                @* 🟢 New Doctor *@
                                @if (isNewDoctor)
                                {
                                    <form asp-action="ApproveDoctor"
                                          asp-controller="Admin"
                                          asp-route-id="@doctor.DoctorId"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-success btn-sm">
                                            Approve Doctor
                                        </button>
                                    </form>

                                    <form asp-action="RejectDoctor"
                                          asp-controller="Admin"
                                          asp-route-id="@doctor.DoctorId"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-danger btn-sm">
                                            Reject Doctor
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    @* 🔴 Fee Change *@
                                    <form asp-action="ApproveFee"
                                          asp-controller="Doctors"
                                          asp-route-id="@doctor.DoctorId"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-danger btn-sm">
                                            Approve Fee
                                        </button>
                                    </form>

                                    <form asp-action="RejectFee"
                                          asp-controller="Doctors"
                                          asp-route-id="@doctor.DoctorId"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-outline-secondary btn-sm">
                                            Reject Fee
                                        </button>
                                    </form>
                                }
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
